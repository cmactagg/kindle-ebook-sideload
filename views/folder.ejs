<%- include('partials/header') %>

<div class="section">
  <% if (error) { %>
    <div class="message message-error">
      <strong>Error:</strong> <%= error %>
    </div>
  <% } %>
  
  <% if (success) { %>
    <div class="message message-success">
      <strong>Success:</strong> <%= success %>
    </div>
  <% } %>
  
  <p><a href="/">&larr; Back to Home</a></p>
</div>

<div class="section">
  <h2><span class="folder-icon"><%= folder.name %></span></h2>
  
  <div class="list-item-actions">
    <form action="/folders/<%= folder._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this folder? It must be empty.');">
      <button type="submit" class="btn btn-small btn-danger">Delete Folder</button>
    </form>
  </div>
</div>

<div class="section">
  <h3>Ebooks in this folder</h3>
  
  <% if (ebooks.length === 0) { %>
    <p class="empty-message">No ebooks in this folder.</p>
  <% } else { %>
    <ul class="list">
      <% ebooks.forEach(function(ebook) { %>
        <li class="list-item">
          <a href="/download/<%= ebook._id %>" class="list-item-title">
            <%= ebook.originalName %>
          </a>
          <span class="list-item-meta">
            <%= ebook.getFormattedSize() %> | 
            Uploaded: <%= ebook.uploadedAt.toLocaleDateString() %>
          </span>
          <div class="list-item-actions">
            <form action="/ebooks/<%= ebook._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this ebook?');">
              <button type="submit" class="btn btn-small btn-danger">Delete</button>
            </form>
            
            <form action="/ebooks/<%= ebook._id %>/move" method="POST" class="inline-form">
              <select name="folder">
                <option value="">-- Root --</option>
                <% folders.forEach(function(f) { %>
                  <% if (f._id.toString() !== folder._id.toString()) { %>
                    <option value="<%= f._id %>"><%= f.name %></option>
                  <% } %>
                <% }); %>
              </select>
              <button type="submit" class="btn btn-small">Move</button>
            </form>
          </div>
        </li>
      <% }); %>
    </ul>
  <% } %>
</div>

<%- include('partials/footer') %>
