<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Kindle Ebook Library' %></title>
  <style>
    /* Minimal CSS for Kindle browser compatibility */
    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: serif;
      font-size: 18px;
      line-height: 1.6;
      background: #fff;
      color: #000;
      padding: 15px;
      max-width: 800px;
      margin: 0 auto;
    }
    
    h1, h2, h3 {
      margin-bottom: 15px;
      font-weight: bold;
    }
    
    h1 { font-size: 24px; border-bottom: 2px solid #000; padding-bottom: 10px; }
    h2 { font-size: 20px; }
    h3 { font-size: 18px; }
    
    a {
      color: #000;
      text-decoration: underline;
    }
    
    a:visited {
      color: #333;
    }
    
    .nav {
      margin-bottom: 20px;
      padding: 10px 0;
      border-bottom: 1px solid #ccc;
    }
    
    .nav a {
      margin-right: 20px;
      padding: 10px 0;
      display: inline-block;
    }
    
    .btn {
      display: inline-block;
      padding: 12px 20px;
      border: 2px solid #000;
      background: #fff;
      color: #000;
      text-decoration: none;
      margin: 5px 5px 5px 0;
      cursor: pointer;
      font-size: 16px;
      font-family: serif;
    }
    
    .btn:hover, .btn:focus {
      background: #000;
      color: #fff;
    }
    
    .btn-small {
      padding: 8px 12px;
      font-size: 14px;
    }
    
    .btn-danger {
      border-color: #333;
    }
    
    .message {
      padding: 15px;
      margin-bottom: 20px;
      border: 2px solid #000;
    }
    
    .message-error {
      background: #f5f5f5;
    }
    
    .message-success {
      background: #f0f0f0;
    }
    
    .list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    
    .list-item {
      padding: 15px 10px;
      border-bottom: 1px solid #ccc;
    }
    
    .list-item:last-child {
      border-bottom: none;
    }
    
    .list-item-title {
      font-weight: bold;
      font-size: 18px;
      display: block;
      margin-bottom: 5px;
    }
    
    .list-item-meta {
      font-size: 14px;
      color: #555;
    }
    
    .list-item-actions {
      margin-top: 10px;
    }
    
    .folder-icon::before {
      content: "[Folder] ";
    }
    
    .section {
      margin-bottom: 30px;
    }
    
    .form-group {
      margin-bottom: 15px;
    }
    
    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
    }
    
    input[type="text"],
    input[type="file"],
    select {
      width: 100%;
      padding: 12px;
      font-size: 16px;
      border: 2px solid #000;
      font-family: serif;
    }
    
    input[type="file"] {
      padding: 10px;
    }
    
    .status {
      margin-top: 15px;
      font-style: italic;
    }
    
    .count-info {
      font-size: 14px;
      color: #555;
      margin-bottom: 15px;
    }
    
    .empty-message {
      padding: 20px;
      text-align: center;
      color: #666;
      font-style: italic;
    }
    
    hr {
      border: none;
      border-top: 1px solid #ccc;
      margin: 20px 0;
    }
    
    /* Large touch targets for Kindle */
    input, button, a, select { min-height: 44px; }
    
    /* Inline form for move action */
    .inline-form {
      display: inline;
    }
    
    .inline-form select {
      width: auto;
      padding: 8px;
    }
  </style>
</head>
<body>
  <%- body %>
</body>
</html>
